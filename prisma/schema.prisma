generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id          String               @id @default(cuid())
  externalKey String               @unique
  studentId   String?
  email       String?
  submissions ExerciseSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([studentId])
  @@index([email])
}

model Exercise {
  id          String               @id @default(cuid())
  slug        String               @unique
  title       String
  submissions ExerciseSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ExerciseSubmission {
  id                String   @id @default(cuid())
  studentRefId      String
  exerciseRefId     String
  student           Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exercise          Exercise @relation(fields: [exerciseRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedStudentId String
  submittedEmail    String?
  completedAt       DateTime
  totalQuestions    Int
  correctCount      Int
  pendingCount      Int
  incorrectCount    Int
  scorePercent      Float
  answersJson       Json
  recipientsJson    Json?
  createdAt         DateTime @default(now())

  @@index([studentRefId, completedAt])
  @@index([exerciseRefId, completedAt])
  @@index([submittedStudentId, completedAt])
}
