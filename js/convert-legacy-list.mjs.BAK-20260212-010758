function resolveHrefForTargetComparison(targetPath, href) {
  const trimmed = (href || "").trim()
  if (!trimmed) return ""
  if (/^(?:[a-z]+:)?\/\//i.test(trimmed)) return ""
  if (/^(?:mailto|tel|javascript):/i.test(trimmed)) return ""
  const clean = trimmed.split("#")[0].split("?")[0]
  if (!clean) return ""
  return path.resolve(path.dirname(targetPath), clean)
}

function normalizeMenuLabel(text) {
  return (text || "").replace(/\s+/g, " ").trim()
}

function syncLegacyFlyoutCurrentState($, menu, targetPath, headline) {
  menu.find("li.current").removeClass("current")
  menu.find("li.opened").removeClass("opened")

  const targetResolved = targetPath ? path.resolve(targetPath) : ""
  const normalizedHeadline = normalizeMenuLabel(headline).toLowerCase()

  if (targetResolved) {
    menu.find("a[href]").each((_, anchor) => {
      const resolvedHref = resolveHrefForTargetComparison(targetResolved, $(anchor).attr("href") || "")
      if (!resolvedHref || path.normalize(resolvedHref) !== path.normalize(targetResolved)) return
      const item = $(anchor).closest("li")
      if (!item.length) return
      item.addClass("current")
      item.parents("li").addClass("opened current")
    })

    if (menu.find("li.current").length) {
      return { matched: true, strategy: "path" }
    }
  }

  if (normalizedHeadline) {
    menu.find("a[href]").each((_, anchor) => {
      const label = normalizeMenuLabel($(anchor).text()).toLowerCase()
      if (!label || label !== normalizedHeadline) return
      const item = $(anchor).closest("li")
      if (!item.length) return
      item.addClass("current")
      item.parents("li").addClass("opened current")
    })
    if (menu.find("li.current").length) {
      return { matched: true, strategy: "headline" }
    }
  }

  return { matched: false, strategy: "none" }
}

function syncRightRailCurrentState($, menu, targetPath, headline) {
  menu.find("[data-r-flyout-item]").removeClass("current is-open")
  menu.find(".r-flyout__sublist li.current, .r-flyout__sublist li.active").removeClass("current active")
  menu.find("[data-r-flyout-item]").each((_, item) => $(item).removeAttr("data-rflyout-start"))
  menu.find(".r-flyout__panel").each((_, panel) => {
    const panelNode = $(panel)
    panelNode.attr("aria-hidden", "true")
    panelNode.attr("hidden", "")
  })
  menu.find(".r-flyout__toggle").attr("aria-expanded", "false")

  const targetResolved = targetPath ? path.resolve(targetPath) : ""
  const normalizedHeadline = normalizeMenuLabel(headline).toLowerCase()

  const applyCurrent = (anchor) => {
    const subItem = $(anchor).closest(".r-flyout__sublist li")
    if (subItem.length) {
      subItem.addClass("current active")
      const parentItem = subItem.closest("[data-r-flyout-item]")
      if (parentItem.length) {
        parentItem.addClass("current")
      }
      return true
    }
    const parentItem = $(anchor).closest("[data-r-flyout-item]")
    if (parentItem.length) {
      parentItem.addClass("current")
      return true
    }
    return false
  }

  if (targetResolved) {
    let matched = false
    menu.find("a[href]").each((_, anchor) => {
      if (matched) return
      const resolvedHref = resolveHrefForTargetComparison(targetResolved, $(anchor).attr("href") || "")
      if (!resolvedHref || path.normalize(resolvedHref) !== path.normalize(targetResolved)) return
      matched = applyCurrent(anchor)
    })
    if (matched) return { matched: true, strategy: "path" }
  }

  if (normalizedHeadline) {
    let matched = false
    menu.find("a[href]").each((_, anchor) => {
      if (matched) return
      const label = normalizeMenuLabel($(anchor).text()).toLowerCase()
      if (!label || label !== normalizedHeadline) return
      matched = applyCurrent(anchor)
    })
    if (matched) return { matched: true, strategy: "headline" }
  }

  return { matched: false, strategy: "none" }
}

function syncFlyoutCurrentState($, targetPath, headline) {
  const legacyMenu = $("ul.flyout-menu").first()
  if (legacyMenu.length) {
    return syncLegacyFlyoutCurrentState($, legacyMenu, targetPath, headline)
  }
  const rightRailMenu = $("ul.r-flyout-menu, ul[data-r-flyout]").first()
  if (rightRailMenu.length) {
    return syncRightRailCurrentState($, rightRailMenu, targetPath, headline)
  }
  return { matched: false, strategy: "none" }
}

function seedRightRailFromLegacy($proto, $legacy) {
