function migrateFlyoutMenuToRightRail($) {
  const menu = $("#aside ul.flyout-menu").first()
  if (!menu.length) return false

  const menuId = menu.attr("id") || "flyout_menu_92"
  const rightMenu = $("<ul>")
    .addClass("r-flyout-menu")
    .attr("id", menuId)
    .attr("data-r-flyout", "")
    .attr("data-flyout-origin", "right")

  menu.children("li").each((index, node) => {
    const item = $(node)
    const headerLink = item.find("> .item-wrapper > .menu-link > a").first()
    if (!headerLink.length) return

    const itemClasses = (item.attr("class") || "")
      .split(/\s+/)
      .map((token) => token.trim())
      .filter(Boolean)
      .filter((token) => !["opened", "open", "is-open"].includes(token))

    const rightItem = $("<li>").attr("data-r-flyout-item", "")
    if (itemClasses.length) rightItem.attr("class", itemClasses.join(" "))

    const header = $("<div>").addClass("item-wrapper r-flyout__header")
    const childItems = item.find("> .ul-wrapper > ul > li")
    const hasChildren = childItems.length > 0
    const label = normalizeMenuLabel(headerLink.text()) || `Menu ${index + 1}`
    const panelId = buildPanelId(label, index)
    const shouldStartOpen =
      item.hasClass("opened") ||
      item.hasClass("open") ||
      item.hasClass("is-open") ||
      item.hasClass("current") ||
      childItems.filter((_, child) => $(child).hasClass("current") || $(child).hasClass("active")).length >
        0

    if (hasChildren) {
      const toggle = $("<button>")
        .addClass("r-flyout__toggle")
        .attr("type", "button")
        .attr("aria-haspopup", "menu")
        .attr("aria-expanded", shouldStartOpen ? "true" : "false")
        .attr("aria-controls", panelId)
        .attr("aria-label", `Toggle submenu for ${label}`)
      toggle.append(buildToggleIcon($, "plus"))
      toggle.append(buildToggleIcon($, "minus"))
      header.append(toggle)
    }

    const linkWrap = $("<div>").addClass("menu-link r-flyout__link-wrap")
    const link = $("<a>").addClass("r-flyout__link")
    const href = headerLink.attr("href") || ""
    link.attr("href", href)
    const ariaLabel = normalizeMenuLabel(headerLink.attr("aria-label") || "")
    if (ariaLabel) link.attr("aria-label", ariaLabel)
    link.text(label)
    linkWrap.append(link)
    header.append(linkWrap)
    rightItem.append(header)

    if (hasChildren) {
      const panel = $("<div>")
        .addClass("ul-wrapper r-flyout__panel")
        .attr("id", panelId)
        .attr("aria-hidden", shouldStartOpen ? "false" : "true")
      if (!shouldStartOpen) {
        panel.attr("hidden", "")
      } else {
        rightItem.addClass("is-open")
        rightItem.attr("data-rflyout-start", "open")
      }

      const subList = $("<ul>").addClass("r-flyout__sublist")
      childItems.each((_, child) => {
        const childNode = $(child)
        const childClasses = normalizeMenuLabel(childNode.attr("class") || "")
        const subItem = $("<li>")
        if (childClasses) subItem.attr("class", childClasses)
        const childWrap = $("<div>").addClass("item-wrapper")
        const childMenuLink = $("<div>").addClass("menu-link")
        const childLink = childNode.find("> .item-wrapper > .menu-link > a").first()
        if (childLink.length) {
          const subAnchor = $("<a>").attr("href", childLink.attr("href") || "")
          const childAriaLabel = normalizeMenuLabel(childLink.attr("aria-label") || "")
          if (childAriaLabel) subAnchor.attr("aria-label", childAriaLabel)
          subAnchor.text(normalizeMenuLabel(childLink.text()))
          childMenuLink.append(subAnchor)
        }
        childWrap.append(childMenuLink)
        subItem.append(childWrap)
        subList.append(subItem)
      })
      panel.append(subList)
      rightItem.append(panel)
    }

    rightMenu.append(rightItem)
  })

  menu.replaceWith(rightMenu)
  return true
}

