function ensureIconSpriteSymbols($) {
  const body = $("body").first()
  if (!body.length) return false

  let changed = false
  let sprite = body.children("svg[aria-hidden='true']").first()
  if (!sprite.length) {
    body.prepend(
      '\n    <svg xmlns="http://www.w3.org/2000/svg" xlink="http://www.w3.org/1999/xlink" aria-hidden="true" class="icon-sprite"><defs></defs></svg>\n'
    )
    sprite = body.children("svg[aria-hidden='true']").first()
    changed = true
  }

  if (sprite.length && !sprite.hasClass("icon-sprite")) {
    sprite.addClass("icon-sprite")
    changed = true
  }

  if (sprite.attr("style")) {
    sprite.removeAttr("style")
    changed = true
  }

  let defs = sprite.children("defs").first()
  if (!defs.length) {
    sprite.prepend("<defs></defs>")
    defs = sprite.children("defs").first()
    changed = true
  }

  if (!defs.children("symbol#icon-plus").length) {
    defs.append(ICON_PLUS_SYMBOL_HTML)
    changed = true
  } else {
    const plus = defs.children("symbol#icon-plus").first()
    if (normalizeCompactMarkup(plus.toString()) !== normalizeCompactMarkup(ICON_PLUS_SYMBOL_HTML)) {
      plus.replaceWith(ICON_PLUS_SYMBOL_HTML)
      changed = true
    }
  }

  if (!defs.children("symbol#icon-minus").length) {
    defs.append(ICON_MINUS_SYMBOL_HTML)
    changed = true
  } else {
    const minus = defs.children("symbol#icon-minus").first()
    if (normalizeCompactMarkup(minus.toString()) !== normalizeCompactMarkup(ICON_MINUS_SYMBOL_HTML)) {
      minus.replaceWith(ICON_MINUS_SYMBOL_HTML)
      changed = true
    }
  }

  return changed
}

function normalizeCompactMarkup(value) {
  return String(value || "")
    .replace(/\s+/g, " ")
    .trim()
}

