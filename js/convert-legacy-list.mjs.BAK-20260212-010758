function normalizeRightRailSchema($) {
  const menu = $("#aside ul.r-flyout-menu, #aside ul[data-r-flyout]").first()
  if (!menu.length) return 0

  let changed = 0
  if (!menu.hasClass("r-flyout-menu")) {
    menu.addClass("r-flyout-menu")
    changed += 1
  }
  if (!menu.attr("data-r-flyout")) {
    menu.attr("data-r-flyout", "")
    changed += 1
  }
  if (!menu.attr("data-flyout-origin")) {
    menu.attr("data-flyout-origin", "right")
    changed += 1
  }

  const seenPanelIds = new Set()
  menu.find(".r-flyout__panel[id]").each((_, panelNode) => {
    const panelId = normalizeMenuLabel($(panelNode).attr("id") || "")
    if (panelId) seenPanelIds.add(panelId)
  })

  menu.children("li").each((index, itemNode) => {
    const item = $(itemNode)
    if (!item.attr("data-r-flyout-item")) {
      item.attr("data-r-flyout-item", "")
      changed += 1
    }

    const header = item.children(".item-wrapper").first()
    if (!header.length) return
    if (!header.hasClass("r-flyout__header")) {
      header.addClass("r-flyout__header")
      changed += 1
    }

    let linkWrap = header.children(".menu-link").first()
    if (!linkWrap.length) {
      const fallbackLink = header.find("a, p").first()
      if (fallbackLink.length) {
        linkWrap = $("<div>").addClass("menu-link r-flyout__link-wrap")
        fallbackLink.replaceWith(linkWrap.append(fallbackLink))
        changed += 1
      }
    }
    if (!linkWrap.length) return
    if (!linkWrap.hasClass("menu-link")) {
      linkWrap.addClass("menu-link")
      changed += 1
    }
    if (!linkWrap.hasClass("r-flyout__link-wrap")) {
      linkWrap.addClass("r-flyout__link-wrap")
      changed += 1
    }

    const headerLink = linkWrap.children("a").first()
    if (headerLink.length && !headerLink.hasClass("r-flyout__link")) {
      headerLink.addClass("r-flyout__link")
      changed += 1
    }

    const label = normalizeMenuLabel(headerLink.text()) || `Menu ${index + 1}`
    const panel = item.children(".r-flyout__panel, .ul-wrapper").first()
    const hasPanel = panel.length > 0

    if (!hasPanel) {
      const toggle = header.children(".r-flyout__toggle")
      if (toggle.length) {
        toggle.remove()
        changed += 1
      }
      if (item.hasClass("is-open")) {
        item.removeClass("is-open")
        changed += 1
      }
      if (item.attr("data-rflyout-start")) {
        item.removeAttr("data-rflyout-start")
        changed += 1
      }
      return
    }

    const panelClassTokens = new Set(
      (panel.attr("class") || "")
        .split(/\s+/)
        .map((token) => token.trim())
        .filter(Boolean)
    )
    panelClassTokens.add("ul-wrapper")
    panelClassTokens.add("r-flyout__panel")
    const normalizedPanelClass = Array.from(panelClassTokens).join(" ")
    if ((panel.attr("class") || "") !== normalizedPanelClass) {
      panel.attr("class", normalizedPanelClass)
      changed += 1
    }

    let panelId = normalizeMenuLabel(panel.attr("id") || "")
    if (!panelId || seenPanelIds.has(panelId)) {
      panelId = buildPanelId(label, index)
      while (seenPanelIds.has(panelId)) {
        panelId = `${panelId}-${index + 1}`
      }
      panel.attr("id", panelId)
      changed += 1
    }
    seenPanelIds.add(panelId)

    const subList = panel.children("ul").first()
    if (subList.length && !subList.hasClass("r-flyout__sublist")) {
      subList.addClass("r-flyout__sublist")
      changed += 1
    }

    subList.children("li").each((_, subItemNode) => {
      const subItem = $(subItemNode)
      let wrapper = subItem.children(".item-wrapper").first()
      if (!wrapper.length) {
        wrapper = $("<div>").addClass("item-wrapper")
        wrapper.append(subItem.contents())
        subItem.append(wrapper)
        changed += 1
      }

      let menuLink = wrapper.children(".menu-link").first()
      if (!menuLink.length) {
        menuLink = $("<div>").addClass("menu-link")
        menuLink.append(wrapper.contents())
        wrapper.append(menuLink)
        changed += 1
      }
    })

    let toggle = header.children("button.r-flyout__toggle").first()
    if (!toggle.length) {
      toggle = $("<button>").addClass("r-flyout__toggle")
      toggle.prepend(buildToggleIcon($, "plus"))
      toggle.append(buildToggleIcon($, "minus"))
      header.prepend(toggle)
      changed += 1
    }

    const ensureToggleAttr = (attr, value) => {
      if (toggle.attr(attr) !== value) {
        toggle.attr(attr, value)
        changed += 1
      }
    }
    ensureToggleAttr("type", "button")
    ensureToggleAttr("aria-haspopup", "menu")
    ensureToggleAttr("aria-controls", panelId)
    ensureToggleAttr("aria-label", `Toggle submenu for ${label}`)

    if (!toggle.find(".r-flyout__icon--plus").length) {
      toggle.prepend(buildToggleIcon($, "plus"))
      changed += 1
    }
    if (!toggle.find(".r-flyout__icon--minus").length) {
      toggle.append(buildToggleIcon($, "minus"))
      changed += 1
    }

    const shouldOpen =
      panel.attr("aria-hidden") === "false" ||
      !panel.is("[hidden]") ||
      item.hasClass("is-open") ||
      item.attr("data-rflyout-start") === "open"

    if (shouldOpen) {
      if (!item.hasClass("is-open")) {
        item.addClass("is-open")
        changed += 1
      }
      if (item.attr("data-rflyout-start") !== "open") {
        item.attr("data-rflyout-start", "open")
        changed += 1
      }
      if (panel.attr("aria-hidden") !== "false") {
        panel.attr("aria-hidden", "false")
        changed += 1
      }
      if (panel.is("[hidden]")) {
        panel.removeAttr("hidden")
        changed += 1
      }
      ensureToggleAttr("aria-expanded", "true")
    } else {
      if (item.hasClass("is-open")) {
        item.removeClass("is-open")
        changed += 1
      }
      if (item.attr("data-rflyout-start")) {
        item.removeAttr("data-rflyout-start")
        changed += 1
      }
      if (panel.attr("aria-hidden") !== "true") {
        panel.attr("aria-hidden", "true")
        changed += 1
      }
      if (!panel.is("[hidden]")) {
        panel.attr("hidden", "")
        changed += 1
      }
      ensureToggleAttr("aria-expanded", "false")
    }
  })

  return changed
}

function normalizeBodyPageClass($, pageClass) {
  const body = $("body").first()
  if (!body.length) return false

  const classList = (body.attr("class") || "")
    .split(/\s+/)
    .map((token) => token.trim())
    .filter(Boolean)
  const pageTypes = new Set(["lesson", "list", "exercize", "exercise"])
  const normalized = classList.filter((token) => !pageTypes.has(token.toLowerCase()))
  if (!normalized.includes("base")) normalized.unshift("base")
  normalized.push(pageClass)
  const deduped = Array.from(new Set(normalized))
  const next = deduped.join(" ")
  if ((body.attr("class") || "").trim() === next) return false
  body.attr("class", next)
  return true
}

function replaceAnchorLabel($, anchor, label, position) {
  if (!anchor.length) return
  const normalizedLabel = (label || "").replace(/\s+/g, " ").trim()
  anchor.find("span.pager-label").remove()
  anchor
    .contents()
    .filter((_, node) => node.type === "text")
    .remove()

  if (!normalizedLabel) return

  const labelNode = $("<span>").addClass("pager-label").text(normalizedLabel)
  const iconNodes = anchor.children("svg, img")
  if (position === "before" && iconNodes.length) {
    iconNodes.first().before(labelNode)
  } else if (position === "after" && iconNodes.length) {
    iconNodes.first().after(labelNode)
  } else if (position === "before") {
    anchor.prepend(labelNode)
  } else {
    anchor.append(labelNode)
  }
}

function updatePager($, pager, data) {
  if (!pager || !pager.length) return
  if (data.previous) {
    const prev = pager.find("li.previous a").first()
    if (prev.length) {
      prev.attr("href", data.previous.href || "")
      prev.attr("rel", data.previous.rel || "prev")
      prev.attr("aria-label", data.previous.ariaLabel || "Previous")
      replaceAnchorLabel($, prev, data.previous.label, "after")
    }
  }
  if (data.next) {
    const next = pager.find("li.next a").first()
    if (next.length) {
      next.attr("href", data.next.href || "")
      next.attr("rel", data.next.rel || "next")
      next.attr("aria-label", data.next.ariaLabel || "Next")
      replaceAnchorLabel($, next, data.next.label, "before")
    }
  }
}

function replaceListBody($, contentHtml) {
  const articleBody = $("div[itemprop='articleBody']").first()
  if (!articleBody.length) return

  const breadcrumb = articleBody.find("nav.breadcrumb-wrap").first()
  const pagers = articleBody.find("ul.pager.pagenav")
  const topPager = pagers.first()
  const bottomPager = pagers.last()

  const keep = new Set()
  if (breadcrumb.length) keep.add(breadcrumb.get(0))
  if (topPager.length) keep.add(topPager.get(0))
  if (bottomPager.length) keep.add(bottomPager.get(0))

  articleBody
    .children()
    .toArray()
    .forEach((child) => {
      if (!keep.has(child)) $(child).remove()
    })

  const trimmed = (contentHtml || "").trim()
  if (trimmed) {
    if (topPager.length && bottomPager.length && topPager.get(0) !== bottomPager.get(0)) {
      topPager.after(`\n${trimmed}\n`)
    } else if (breadcrumb.length) {
      breadcrumb.after(`\n${trimmed}\n`)
    } else {
      articleBody.prepend(`\n${trimmed}\n`)
    }
  }

  if (bottomPager.length && topPager.get(0) !== bottomPager.get(0)) {
    const bottomHtml = bottomPager.toString()
    bottomPager.remove()
    articleBody.append(`\n`)
    articleBody.append(bottomHtml)
  }
}

function enforceLeanHeadShell($) {
  const removed = {
    inlineBlocks: 0,
    speculationScripts: 0,
  }

  $("style#pager-style-overrides, style#critical-inline-augment").each((_, node) => {
    $(node).remove()
    removed.inlineBlocks += 1
  })

  $("script").each((_, node) => {
    const text = ($(node).html() || "").trim()
    if (!text) return
    if (text.includes("speculationrules") && text.includes("injectSpeculation")) {
      $(node).remove()
      removed.speculationScripts += 1
    }
  })

  const criticalInline = $("style#critical-inline").first()
  if (criticalInline.length) {
    criticalInline.text(`\n${LEAN_CRITICAL_INLINE}\n    `)
  } else {
    $("head").append(`\n    <style id="critical-inline">\n${LEAN_CRITICAL_INLINE}\n    </style>`)
  }

  const body = $("body").first()
  if (body.length && !body.children("script[data-mobile-nav-bootstrap]").length) {
    body.prepend(
      '<script data-mobile-nav-bootstrap>\n      document.body.classList.add("mobile-nav-enabled")\n    </script>\n'
    )
  }

  const sprite = $("body > svg[aria-hidden='true']").first()
  if (sprite.length) {
    sprite.addClass("icon-sprite")
    if (sprite.attr("style")) sprite.removeAttr("style")
  }

  return removed
}

function ensureMenuStateTokens($) {
  const themeVars = $("style#theme-vars-critical").first()
  if (!themeVars.length) return false

  const css = themeVars.html() || ""
  if (
    css.includes("--menu-state-bg:") &&
    css.includes("--menu-state-border:") &&
    css.includes("--menu-state-text:")
  ) {
    return false
  }

  let updated = css
  if (updated.includes("--r-flyout-transition:")) {
    updated = updated.replace(
      /(--r-flyout-transition:[^\n]*\n)/,
      (_, line) => `${line}${MENU_STATE_TOKENS}\n`
    )
  } else if (updated.includes("--menu-icon-pad-inline:")) {
    updated = updated.replace(
      /(--menu-icon-pad-inline:[^\n]*\n)/,
      (_, line) => `${line}${MENU_STATE_TOKENS}\n`
    )
  } else {
    updated = updated.replace(/(:root\s*{)/, `$1\n${MENU_STATE_TOKENS}`)
  }

  themeVars.html(updated)
  return true
}

function normalizeLeadHeadingText(text) {
  const raw = (text || "").replace(/\s+/g, " ").trim()
  if (!raw) return ""
  return raw.replace(/^\d+(?:\.\d+)*\s*[-:.]?\s*/, "").trim() || raw
}

function ensureLeadH3BeforeContent($, fallbackText) {
  const articleBody = $("div[itemprop='articleBody']").first()
  if (!articleBody.length) return false

  const firstContentNode = articleBody
    .children()
    .filter((_, el) => {
      const tag = String(el.tagName || "").toLowerCase()
      return tag && tag !== "nav" && !(tag === "ul" && $(el).hasClass("pager"))
    })
    .first()

  if (!firstContentNode.length) return false

  const tag = String(firstContentNode.get(0)?.tagName || "").toLowerCase()
  if (/^h[1-6]$/.test(tag)) {
    if (tag === "h3") return false
    const replacement = $("<h3>")
    const attrs = firstContentNode.attr() || {}
    Object.entries(attrs).forEach(([key, value]) => replacement.attr(key, value))
    replacement.html(firstContentNode.html() || "")
    firstContentNode.replaceWith(replacement)
    return true
  }

  const headingText = normalizeLeadHeadingText(fallbackText) || "The List"
  firstContentNode.before($("<h3>").text(headingText))
  return true
}

