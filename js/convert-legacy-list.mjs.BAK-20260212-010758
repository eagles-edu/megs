function naturalCompare(a, b) {
  return NATURAL_COLLATOR.compare(a, b)
}

function listListDirectories(root) {
  if (!fs.existsSync(root)) return []
  return fs
    .readdirSync(root, { withFileTypes: true })
    .filter((entry) => entry.isDirectory() && entry.name.startsWith(LIST_DIRECTORY_PREFIX))
    .map((entry) => path.join(root, entry.name))
    .sort((a, b) => naturalCompare(path.basename(a), path.basename(b)))
}

function listListFiles(dir, includeCopy) {
  if (!fs.existsSync(dir)) return []
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .filter(
      (entry) =>
        entry.isFile() &&
        entry.name.toLowerCase().endsWith(".html") &&
        (includeCopy || !isCopyFile(entry.name))
    )
    .map((entry) => entry.name)
    .sort(naturalCompare)
}

function isCopyFile(name) {
  const lower = name.toLowerCase()
  return COPY_FILE_SUFFIXES.some((suffix) => lower.endsWith(suffix))
}

