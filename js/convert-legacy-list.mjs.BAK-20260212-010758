function resolveAssetPathForVerify(targetPath, href) {
  if (!targetPath || !href) return null
  const cleanHref = String(href).split("#")[0].split("?")[0]
  if (!cleanHref || /^(?:[a-z]+:)?\/\//i.test(cleanHref) || cleanHref.startsWith("data:")) return null
  const baseDir = path.dirname(path.resolve(targetPath))
  return path.resolve(baseDir, cleanHref)
}

function verifyRightRailCssFeatures(html, targetPath) {
  const issues = []
  const $ = load(html, { decodeEntities: false })
  const href =
    $('link[rel="stylesheet"][href*="right-rail-flyout.css"]').first().attr("href") || RIGHT_RAIL_CSS
  const cssPath = resolveAssetPathForVerify(targetPath, href)
  if (!cssPath || !fs.existsSync(cssPath)) {
    issues.push("right-rail css file missing")
    return issues
  }
  const cssText = fs.readFileSync(cssPath, "utf8")
  for (const check of RIGHT_RAIL_CSS_VERIFY_CHECKS) {
    if (!check.pattern.test(cssText)) issues.push(`right-rail css missing: ${check.name}`)
  }
  return issues
}

function verifyRightRailMenuStructure(html) {
  const issues = []
  const $ = load(html, { decodeEntities: false })
  const menu = $('ul.r-flyout-menu[data-r-flyout]').first()
  if (!menu.length) return issues

  if (menu.find("[data-r-flyout-item].is-open").length) {
    issues.push("right-rail should not start with is-open items")
  }

  const panelById = new Map()
  menu.find(".r-flyout__panel[id]").each((_, panel) => {
    panelById.set($(panel).attr("id"), $(panel))
  })

  menu.find(".r-flyout__toggle").each((_, toggle) => {
    const controls = ($(toggle).attr("aria-controls") || "").trim()
    if (!controls) {
      issues.push("right-rail toggle missing aria-controls")
      return
    }
    if (!panelById.has(controls)) {
      issues.push(`right-rail toggle aria-controls has no panel: ${controls}`)
      return
    }
    const expanded = (($(toggle).attr("aria-expanded") || "").trim() || "false").toLowerCase()
    if (expanded !== "false") {
      issues.push(`right-rail toggle should start collapsed: ${controls}`)
    }
  })

  panelById.forEach((panel, panelId) => {
    if (panel.attr("hidden") === undefined) {
      issues.push(`right-rail panel missing hidden attr: ${panelId}`)
    }
    const ariaHidden = (panel.attr("aria-hidden") || "").trim().toLowerCase()
    if (ariaHidden !== "true") {
      issues.push(`right-rail panel must start aria-hidden=true: ${panelId}`)
    }
  })

  menu.find("[data-r-flyout-item]").each((_, item) => {
    const hasPanel = $(item).find("> .r-flyout__panel").length > 0
    const hasToggle = $(item).find("> .r-flyout__header .r-flyout__toggle").length > 0
    if (hasPanel && !hasToggle) {
      issues.push("right-rail item with panel is missing toggle")
    } else if (!hasPanel && hasToggle) {
      issues.push("right-rail item has toggle but no panel")
    }
  })

  return issues
}

function verifyListShellContent(html, targetPath) {
  const missing = SHELL_VERIFY_CHECKS.filter((check) => !check.pattern.test(html)).map(
    (check) => check.name
  )
  const forbidden = SHELL_VERIFY_FORBIDDEN_CHECKS.filter((check) => check.pattern.test(html)).map(
    (check) => check.name
  )
  const structuralIssues = verifyRightRailMenuStructure(html)
  const cssIssues = verifyRightRailCssFeatures(html, targetPath)
  const issues = [
    ...missing,
    ...forbidden.map((name) => `forbidden:${name}`),
    ...structuralIssues,
    ...cssIssues,
  ]
  return {
    ok: issues.length === 0,
    missing,
    forbidden,
    structuralIssues,
    cssIssues,
    issues,
  }
}

function createPrompter() {
  if (!process.stdin.isTTY) return null
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout })
  const ask = (question) =>
    new Promise((resolve) => {
      rl.question(question, (answer) => resolve(answer))
    })
  return { ask, close: () => rl.close() }
}

async function pauseForDirectory(ask, directoryRel, pauseEnabled) {
  if (!pauseEnabled) return true
  const prompt = `[pause] ${directoryRel}: press Enter to continue (Q to quit): `
  if (!ask) {
    console.log(`${prompt}non-interactive session; continuing automatically`)
    return true
  }
  const input = (await ask(prompt)).trim().toLowerCase()
  return input !== "q" && input !== "quit"
}

function printDirectorySummary(directoryRel, entries) {
  console.log(`[dir-summary] ${directoryRel} touched=${entries.length}`)
  if (!entries.length) {
    console.log("  [PASS] none")
    return
  }
  entries.forEach((entry) => {
    const label = entry.status === "pass" ? "PASS" : "FAIL"
    const extras = []
    if (entry.verifyStatus) extras.push(`verify=${String(entry.verifyStatus).toUpperCase()}`)
    if (entry.message) extras.push(entry.message)
    if (entry.verifyMessage) extras.push(`verify-detail: ${entry.verifyMessage}`)
    const suffix = extras.length ? ` :: ${extras.join(" | ")}` : ""
    console.log(`  [${label}] ${entry.file}${suffix}`)
  })
}

function buildConversionResult(targetPath, prototypePath, args) {
  ensureFileExists(targetPath)
  ensureFileExists(prototypePath)

  const legacyHtml = loadHtml(targetPath)
  const protoHtml = loadHtml(prototypePath)

  const $legacy = load(legacyHtml, { decodeEntities: false })
  const $proto = load(protoHtml, { decodeEntities: false })

  const { title, headline } = extractHeadline($legacy)
  const breadcrumbs = scrapeBreadcrumbs($legacy)
  const pager = scrapePager($legacy)
  const legacyBody = extractLegacyBody($legacy)
  const cleanedBody = normalizeListSpacing(legacyBody)
  const normalizedUsageBody = args.ukToUs ? normalizeListUsage(cleanedBody.html) : cleanedBody.html

  const allowedClasses = buildAllowedClassSet($proto, prototypePath)
  const normalized = normalizeListBody(normalizedUsageBody, allowedClasses)

  updateTitleAndHeadline($proto, title, headline, targetPath)
  const rightRailSeededFromLegacy = seedRightRailFromLegacy($proto, $legacy)

  const breadcrumbLists = $proto("nav.breadcrumb-wrap ul.breadcrumb")
  if (breadcrumbLists.length) {
    updateBreadcrumbList($proto, breadcrumbLists.first(), breadcrumbs)
    updateBreadcrumbList($proto, breadcrumbLists.last(), breadcrumbs)
  }

  const pagerLists = $proto("ul.pager.pagenav")
  if (pagerLists.length) {
    updatePager($proto, pagerLists.first(), pager)
    if (pagerLists.length > 1) updatePager($proto, pagerLists.last(), pager)
  }

  highlightListsNav($proto)
  const leftIconsMoved = normalizeLeftSidebarIcons($proto)
  const rightRailMigrated = migrateFlyoutMenuToRightRail($proto)
  const rightRailContainerNormalized = normalizeRightRailContainer($proto, "Lists")
  const rightRailSchemaNormalized = normalizeRightRailSchema($proto)
  const flyoutCurrent = syncFlyoutCurrentState($proto, targetPath, headline)
  const bodyClassNormalized = normalizeBodyPageClass($proto, "list")
  const rightRailAssetsUpdated = ensureRightRailAssets($proto)
  const footerNormalized = normalizeFooterShell($proto)
  const shellChanges = enforceLeanHeadShell($proto)
  const iconSpriteUpdated = ensureIconSpriteSymbols($proto)
  const menuTokenAdded = ensureMenuStateTokens($proto)
  const yearScriptEnsured = ensureCopyrightYearScript($proto)

  replaceListBody($proto, normalized.html)
  const insertedLeadH3 = ensureLeadH3BeforeContent($proto, headline)

  let updated = $proto.html()
  updated = stripLegacyFlyoutAssets(updated)
  updated = updated.replace(/\bviewbox=/g, "viewBox=")
  updated = collapseBooleanAttributes(updated)
  updated = rewriteDocumentPathComments(updated, targetPath)
  updated = trimTrailingWhitespace(updated)

  const summary = [
    `headline: ${headline || "(none)"}`,
    `breadcrumbs: ${breadcrumbs.length}`,
    `pager: prev=${pager.previous ? "yes" : "no"}, next=${pager.next ? "yes" : "no"}`,
    `normalized: removed ${normalized.removedStyles} inline style(s), dropped ${normalized.removedClassTokens} class token(s)`,
    `left menu icons: moved ${leftIconsMoved}`,
    `right rail source: ${rightRailSeededFromLegacy ? "seeded from legacy" : "prototype"}`,
    `right rail: ${rightRailMigrated ? "migrated to r-flyout" : "already modern"}`,
    `right rail shell: ${rightRailContainerNormalized ? "normalized" : "ok"}`,
    `right rail items: ${rightRailSchemaNormalized ? `normalized ${rightRailSchemaNormalized}` : "ok"}`,
    `body class: ${bodyClassNormalized ? "normalized to base list" : "ok"}`,
    `shell assets: ${rightRailAssetsUpdated ? "updated" : "ok"}`,
    `footer shell: ${footerNormalized ? "normalized" : "ok"}`,
    `head shell: removed ${shellChanges.inlineBlocks} inline block(s), ${shellChanges.speculationScripts} speculation script(s)`,
    `icon sprite: ${iconSpriteUpdated ? "updated" : "ok"}`,
    `menu tokens: ${menuTokenAdded ? "added" : "ok"}`,
    `footer year script: ${yearScriptEnsured ? "added" : "ok"}`,
    `right menu current: ${
      flyoutCurrent.strategy === "path"
        ? "matched target path"
        : flyoutCurrent.strategy === "headline"
          ? "matched headline"
          : "fallback prototype state"
    }`,
    `lead h3: ${insertedLeadH3 ? "normalized" : "ok"}`,
    `usage normalization: ${args.ukToUs ? "uk->us" : "none"}`,
  ]
  if (cleanedBody.stats.replacementChars) {
    summary.push(`replacement chars removed: ${cleanedBody.stats.replacementChars}`)
  }
  if (cleanedBody.stats.nbspCount) {
    summary.push(`nbsp normalized: ${cleanedBody.stats.nbspCount}`)
  }
  if (cleanedBody.stats.collapsedSpaces) {
    summary.push(`spaces collapsed: ${cleanedBody.stats.collapsedSpaces}`)
  }
  if (normalized.orphaned.length) {
    summary.push(`orphaned classes removed: ${normalized.orphaned.slice(0, 10).join(", ")}${
      normalized.orphaned.length > 10 ? "..." : ""
    }`)
  }

  return {
    legacyHtml,
    updated,
    summary,
  }
}

function runSingleConversion(args) {
  const targetPath = resolvePathMaybe(args.target)
  const prototypePath = resolvePathMaybe(args.prototype)
  const conversion = buildConversionResult(targetPath, prototypePath, args)

  if (args.diffPreview) {
    console.log(showDiff(conversion.legacyHtml, conversion.updated))
    logSummary(conversion.summary)
    if (args.verifyShell) {
      console.log("[verify] SKIP diff preview mode")
    }
    console.log("Diff preview complete. Re-run with --no-diff-preview to write changes.")
    return
  }

  const backupPath = backupFile(targetPath)
  fs.writeFileSync(targetPath, conversion.updated, "utf8")
  logSummary(conversion.summary)
  console.log(`Wrote updated list to ${targetPath}`)
  console.log(`Backup created at ${backupPath}`)

  if (!args.verifyShell) {
    console.log("[verify] SKIP --no-verify-shell")
    return
  }

  const verification = verifyListShellContent(conversion.updated, targetPath)
  if (!verification.ok) {
    console.log(`[verify] FAIL :: ${verification.issues.join(", ")}`)
    process.exitCode = 1
    return
  }
  console.log("[verify] PASS")
}

async function runBulkConversion(args) {
  const root = path.isAbsolute(args.root) ? args.root : path.resolve(process.cwd(), args.root)
  if (!fs.existsSync(root)) fail(`Root path not found: ${root}`)
  const directories = listListDirectories(root)
  if (!directories.length) {
    console.log("No list-* directories found.")
    return
  }

  const prototypePath = resolvePathMaybe(args.prototype)
  ensureFileExists(prototypePath)

  const prompter = createPrompter()
  const ask = prompter?.ask ?? null
  let conversionStarted = false
  let aborted = false
  let conversionFailures = 0
  let verifyFailures = 0

  try {
    for (const directory of directories) {
      const relativeDir = path.relative(root, directory)
      const files = listListFiles(directory, args.includeCopy)
      if (!files.length) {
        if (conversionStarted) {
          printDirectorySummary(relativeDir, [])
          if (!(await pauseForDirectory(ask, relativeDir, args.pausePerDirectory))) {
            aborted = true
            break
          }
        }
        continue
      }

      const touchedEntries = []
      for (const fileName of files) {
        const absoluteFile = path.join(directory, fileName)
        const shortName = fileName
        const relPath = path.relative(root, absoluteFile)
        let fileHtml = ""
        try {
          fileHtml = fs.readFileSync(absoluteFile, "utf8")
        } catch (error) {
          touchedEntries.push({ file: shortName, status: "fail", message: error.message })
          console.log(`[fail] ${relPath} :: ${error.message}`)
          continue
        }

        const converted = isListConverted(fileHtml)
        if (!conversionStarted) {
          if (converted) continue
          conversionStarted = true
        }
        if (!conversionStarted) continue
        if (converted) continue

        try {
          const conversion = buildConversionResult(absoluteFile, prototypePath, args)
          if (args.diffPreview) {
            console.log(showDiff(conversion.legacyHtml, conversion.updated))
            logSummary(conversion.summary)
            console.log(`[bulk] Diff preview complete for ${relPath}`)
            touchedEntries.push({
              file: shortName,
              status: "pass",
              verifyStatus: "skip",
              verifyMessage: "diff preview mode",
            })
          } else {
            const backupPath = backupFile(absoluteFile)
            fs.writeFileSync(absoluteFile, conversion.updated, "utf8")
            logSummary(conversion.summary)
            console.log(`[bulk] Wrote updated list to ${relPath}`)
            console.log(`[bulk] Backup created at ${backupPath}`)
            if (!args.verifyShell) {
              touchedEntries.push({
                file: shortName,
                status: "pass",
                verifyStatus: "skip",
                verifyMessage: "--no-verify-shell",
              })
            } else {
              const verification = verifyListShellContent(conversion.updated, absoluteFile)
              if (!verification.ok) {
                verifyFailures += 1
                const verifyMessage = verification.issues.join(", ")
                touchedEntries.push({
                  file: shortName,
                  status: "pass",
                  verifyStatus: "fail",
                  verifyMessage,
                })
                console.log(`[verify-fail] ${relPath} :: ${verifyMessage}`)
              } else {
                touchedEntries.push({
                  file: shortName,
                  status: "pass",
                  verifyStatus: "pass",
                })
              }
            }
          }
        } catch (error) {
          conversionFailures += 1
          touchedEntries.push({ file: shortName, status: "fail", message: error.message })
          console.log(`[fail] ${relPath} :: ${error.message}`)
        }
      }

      if (!conversionStarted) continue
      printDirectorySummary(relativeDir, touchedEntries)
      if (!(await pauseForDirectory(ask, relativeDir, args.pausePerDirectory))) {
        aborted = true
        break
      }
    }
  } finally {
    prompter?.close()
  }

  if (!conversionStarted && !aborted) {
    console.log("No unconverted lists found inside the specified root.")
  }

  if (conversionFailures || verifyFailures) {
    console.log(
      `[bulk-summary] conversion-failures=${conversionFailures}, verify-failures=${verifyFailures}`
    )
    process.exitCode = 1
  }
}

async function main() {
  const args = parseArgs(process.argv)
  if (args.bulk) {
    await runBulkConversion(args)
  } else {
    runSingleConversion(args)
  }
}

main().catch((error) => {
  console.error(error?.message || error)
  process.exit(1)
})
