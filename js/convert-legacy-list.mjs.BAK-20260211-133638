function parseArgs(argv) {
  const args = {
    target: "",
    prototype: DEFAULT_PROTOTYPE,
    diffPreview: true,
    ukToUs: false,
    verifyShell: true,
    bulk: false,
    root: DEFAULT_ROOT,
    includeCopy: false,
    pausePerDirectory: true,
  }

  for (let i = 2; i < argv.length; i += 1) {
    const arg = argv[i]
    if (arg === "--help" || arg === "-h") {
      printUsage()
      process.exit(0)
    } else if (arg === "--target" || arg === "-f") {
      args.target = argv[++i] || ""
    } else if (arg === "--prototype" || arg === "-p") {
      args.prototype = argv[++i] || ""
    } else if (arg === "--bulk") {
      args.bulk = true
    } else if (arg === "--root") {
      args.root = argv[++i] || args.root
    } else if (arg === "--uk-to-us") {
      args.ukToUs = true
    } else if (arg === "--verify-shell") {
      args.verifyShell = true
    } else if (arg === "--no-verify-shell") {
      args.verifyShell = false
    } else if (arg === "--diff-preview") {
      args.diffPreview = true
    } else if (arg === "--no-diff-preview") {
      args.diffPreview = false
    } else if (arg === "--include-copy") {
      args.includeCopy = true
    } else if (arg === "--no-pause") {
      args.pausePerDirectory = false
    } else if (!args.target && !arg.startsWith("-")) {
      args.target = arg
    } else {
      fail(`Unknown argument: ${arg}`)
    }
  }

  if (!args.bulk && !args.target) fail("Missing legacy list HTML path.")
  if (!args.prototype) fail("Missing prototype path.")
  return args
}

function resolvePathMaybe(relativePath) {
