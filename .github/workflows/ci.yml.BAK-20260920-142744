name: CI
permissions:
  contents: read
  pull-requests: write

on:
  push:
    branches: [ PT-BETA-0.0.04.01 ]
  pull_request:
    branches: [ PT-BETA-0.0.04.01 ]

jobs:
  ci:
    runs-on: ubuntu-22.04
    environment: megs_env
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Use Node 20
        uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm

      - name: Install
        run: npm ci

      - name: Enforce Page Parity (changed lesson pages)
        run: |
          if [ "${{ github.event_name }}" = "pull_request" ]; then
            node tools/check-page-parity.mjs --changed "origin/${{ github.base_ref }}"
          elif [ "${{ github.event.before }}" = "0000000000000000000000000000000000000000" ]; then
            echo "Skipping parity check on branch-creation push."
          else
            node tools/check-page-parity.mjs --changed "${{ github.event.before }}"
          fi

      - name: Lint (JS/CSS/HTML)
        run: npm run lint

      - name: Verify Prototype (QA/menus)
        run: npm run verify:prototype

      - name: Smoke Test Multiple Pages
        run: npm run smoke:pages
