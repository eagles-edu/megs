// Important: You must have a blank line before <!-- prettier-ignore-start --> and <!-- prettier-ignore-end --> for Prettier to recognize the comments.
// <!-- prettier-ignore -->

{
  "logLevel": "debug",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "ignore",
  "overrides": [
    {
      "files": ["*.html", "*.htm"],
      "options": {
        "options": { "parser": "html" },  // 👈 force HTML parser
        "bracketSameLine": true,
        "singleAttributePerLine": true,
        "printWidth": 140,
        "htmlWhitespaceSensitivity": "ignore",
      }
    }
  ]
}
