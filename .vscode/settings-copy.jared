  "checkpoints.showActiveFileOnly": false,
  "checkpoints.addCheckpointOnSave": true,
  "checkpoints.locale": "vi-VN",
  "checkpoints.location": "scm",
  "checkpoints.askForCheckpointName": false,
  "zencoder.mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--root",
        "/home/eagles/dockerz/megs"
      ]
    },
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--browser",
        "firefox",
        "--user-agent",
        "\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.6422.112 Safari/537.36\""
      ]
    },
    "git": {
      "command": "mcp-server-git",
      "args": ["/home/eagles/dockerz/megs"]
    }
  },
  "highlight.decorations": { "rangeBehavior": 3 },
  "highlight.regexFlags": "gim",
  "highlight.maxMatches": 1000,
  "highlight.regexes": {
    // ---------- TABLE TAG PAIRS ----------
    "(<table\\b[^>]*?>)|(</table>)": [
      {
        "overviewRulerColor": "#fde171",
        "backgroundColor": "#fde171",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#b9a143", "backgroundColor": "#b9a143", "color": "#000" }
    ],
    "(<caption\\b[^>]*?>)|(</caption>)": [
      {
        "overviewRulerColor": "#ff71e0",
        "backgroundColor": "#ff71e0",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#bd5ba8", "backgroundColor": "#bd5ba8", "color": "#000" }
    ],
    "(<thead\\b[^>]*?>)|(</thead>)": [
      {
        "overviewRulerColor": "#89d4ff",
        "backgroundColor": "#89d4ff",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#73c5ff", "backgroundColor": "#63b3ed", "color": "#000" }
    ],
    "(<tbody\\b[^>]*?>)|(</tbody>)": [
      {
        "overviewRulerColor": "#89ffae",
        "backgroundColor": "#89ffae",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#68d391", "backgroundColor": "#68d391", "color": "#000" }
    ],
    "(<tfoot\\b[^>]*?>)|(</tfoot>)": [
      {
        "overviewRulerColor": "#ff8585",
        "backgroundColor": "#ff8585",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#ff6f6f", "backgroundColor": "#ff6f6f", "color": "#000" }
    ],
    "(<tr\\b[^>]*?>)|(</tr>)": [
      {
        "overviewRulerColor": "#ff9346",
        "backgroundColor": "#ff9346",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#ff8624", "backgroundColor": "#ff8624", "color": "#000" }
    ],
    "(<th\\b[^>]*?>)|(</th>)": [
      {
        "overviewRulerColor": "#bb8bff",
        "backgroundColor": "#bb8bff",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#8f58fc", "backgroundColor": "#8f58fc", "color": "#e8d7ff" }
    ],
    "(<td\\b[^>]*?>)|(</td>)": [
      {
        "overviewRulerColor": "#56ffff",
        "backgroundColor": "#56ffff",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#19c2c2", "backgroundColor": "#19c2c2", "color": "#000" }
    ],
    "(<colgroup\\b[^>]*?>)|(</colgroup>)": [
      {
        "overviewRulerColor": "#67abf9",
        "backgroundColor": "#67abf9",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#3392ff", "backgroundColor": "#3392ff", "color": "#000" }
    ],
    "(<col\\b[^>]*?/?\\s*>)": [
      {
        "overviewRulerColor": "#81e6d9",
        "backgroundColor": "#81e6d9",
        "color": "#000",
        "fontWeight": "bold"
      }
    ],

    // ---------- TABLE ATTRIBUTES ----------
    "(<t[dh]\\b[^>]*?\\s)(rowspan)(\\s*=\\s*)(\"[^\"]*\"|'[^']*'|[^\\s>]+)": [
      {},
      {
        "overviewRulerColor": "#5beb84",
        "backgroundColor": "#5beb84",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "backgroundColor": "#33ad66", "color": "#000" },
      { "borderWidth": "1px", "borderStyle": "solid", "borderColor": "#646464", "color": "#000" }
    ],
    "(<t[dh]\\b[^>]*?\\s)(colspan)(\\s*=\\s*)(\"[^\"]*\"|'[^']*'|[^\\s>]+)": [
      {},
      {
        "overviewRulerColor": "#fffb7a",
        "backgroundColor": "#fffb7a",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "backgroundColor": "#c5c05f", "color": "#000" },
      { "borderWidth": "1px", "borderStyle": "solid", "borderColor": "#646464", "color": "#000" }
    ],
    "(<th\\b[^>]*?\\s)(scope)(\\s*=\\s*)(\"(?:row|col|rowgroup|colgroup|auto)\"|'(?:row|col|rowgroup|colgroup|auto)'|(?:row|col|rowgroup|colgroup|auto))": [
      {},
      {
        "overviewRulerColor": "#ff4b4b",
        "backgroundColor": "#ff4b4b",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "backgroundColor": "#ff5454", "color": "#000" },
      { "borderWidth": "1px", "borderStyle": "solid", "borderColor": "#646464", "color": "#000" }
    ],

    // ---------- LIST TAG PAIRS ----------
    "(<ul\\b[^>]*?>)|(</ul>)": [
      {
        "overviewRulerColor": "#fcffb0",
        "backgroundColor": "#fcffb0",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#faff69", "backgroundColor": "#faff69", "color": "#000" }
    ],
    "(<ol\\b[^>]*?>)|(</ol>)": [
      {
        "overviewRulerColor": "#a8d5f6",
        "backgroundColor": "#a8d5f6",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#74c0fc", "backgroundColor": "#74c0fc", "color": "#000" }
    ],
    "(<li\\b[^>]*?>)|(</li>)": [
      {
        "overviewRulerColor": "#c59a64",
        "backgroundColor": "#c59a64",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "overviewRulerColor": "#ffa34e", "backgroundColor": "#ffa34e", "color": "#000" }
    ],

    // ---------- LIST ATTRIBUTES ----------
    "(<ol\\b[^>]*?\\s)(start|type)(\\s*=\\s*)(\"[^\"]*\"|'[^']*'|[^\\s>]+)": [
      {},
      {
        "overviewRulerColor": "#92d2ff",
        "backgroundColor": "#92d2ff",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "backgroundColor": "#66ade0", "color": "#000" },
      { "borderWidth": "1px", "borderStyle": "solid", "borderColor": "#646464", "color": "#000" }
    ],
    "(<ol\\b[^>]*?\\s)(reversed)\\b": [
      {},
      {
        "overviewRulerColor": "#d0ebff",
        "backgroundColor": "#d0ebff",
        "color": "#000",
        "fontWeight": "bold"
      }
    ],
    "(<li\\b[^>]*?\\s)(value)(\\s*=\\s*)(\"[^\"]*\"|'[^']*'|[^\\s>]+)": [
      {},
      {
        "overviewRulerColor": "#fff4e6",
        "backgroundColor": "#fff4e6",
        "color": "#000",
        "fontWeight": "bold"
      },
      { "backgroundColor": "#fff4e6", "color": "#000" },
      { "borderWidth": "1px", "borderStyle": "solid", "borderColor": "#ffa94d", "color": "#000" }
    ]
  },
  "cssVarHover.watchedFiles": [
