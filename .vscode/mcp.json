{
  "servers": {
    "sequential-thinking": {
      "command": "npm",
      "args": ["run", "mcp:seq-think"]
    },
    "context7": {
      "command": "npm",
      "args": ["run", "mcp:context7"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--browser",
        "firefox",
        "--user-agent",
        "\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.6422.112 Safari/537.36\""
      ]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${workspaceFolder}"],
      "type": "stdio"
    },
    "github-remote": {
      "command": "uvx",
      "args": ["mcp-server-github", "--remote"]
    }
  }
}
