{
	"servers": {
		"sequential-thinking": {
			"command": "npm",
			"args": [
				"run",
				"mcp:seq-think"
			],
			"type": "stdio"
		},
		"context7": {
			"command": "npm",
			"args": [
				"run",
				"mcp:context7"
			],
			"type": "stdio"
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--isolated",
				"--headless",
				"--browser",
				"firefox",
				"--user-agent",
				"\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.6422.112 Safari/537.36\""
			],
			"type": "stdio"
		},
		"git": {
			"command": "uvx",
			"args": [
				"mcp-server-git",
				"--repository",
				"${workspaceFolder}"
			],
			"type": "stdio"
		},
		"github-remote": {
			"command": "uvx",
			"args": [
				"mcp-server-github",
				"--remote"
			],
			"type": "stdio"
		},
		"codacy/codacy-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@codacy/codacy-mcp@latest"
			],
			"env": {
				"CODACY_ACCOUNT_TOKEN": "${input:codacy_account_token}",
				"CODACY_CLI_VERSION": "${input:codacy_cli_version}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"microsoft/markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"markitdown-mcp==0.0.1a4"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.25"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"chrome-devtools-mcp@0.10.2"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.10.2"
		},
		"sunriseapps/imagesorcery-mcp": {
			"type": "stdio",
			"command": "imagesorcery-mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"zapier/zapier-mcp": {
			"type": "http",
			"url": "{zapier_mcp_url}",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"DevBox": {
			"command": "npx",
			"args": [
				"-y",
				"@microsoft/devbox-mcp@latest"
			],
			"type": "stdio"
		}
	},
	"inputs": [
		{
			"id": "codacy_account_token",
			"type": "promptString",
			"description": "Your Codacy Account API token (from app.codacy.com → Account). Required.",
			"password": true
		},
		{
			"id": "codacy_cli_version",
			"type": "promptString",
			"description": "Optional: pin Codacy CLI version used by local analysis (e.g., 2.3.1).",
			"password": false
		},
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		}
	]
}