{
  "servers": {
    "github": {
      "command": "uvx",
      "args": [
        "mcp-server-github"
      ]
    },
    "sequential-thinking": {
      "command": "npm",
      "args": [
        "run",
        "mcp:seq-think"
      ]
    },
    "github-remote": {
      "command": "uvx",
      "args": [
        "mcp-server-github",
        "--remote"
      ]
    },
    "context7": {
      "command": "npm",
      "args": [
        "run",
        "mcp:context7"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "mcp-server-docker"
      ],
      "type": "stdio"
    },
    "everything": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-everything"
      ],
      "type": "stdio"
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "${workspaceFolder}"
      ],
      "type": "stdio"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem"
      ],
      "type": "stdio"
    },
    "memory": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-memory"
      ],
      "type": "stdio"
    }
  },
  "inputs": []
}